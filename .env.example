# TicketIQ Environment Configuration
# Copy to .env and fill in your own values. NEVER commit the real .env.

# ── Clerk Authentication (https://clerk.com) ──────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_your_secret_key

# ── Kimi / Moonshot AI — chatbot (https://api.moonshot.ai) ──
KIMI_API_KEY=your_kimi_api_key_here
# The chatbot falls back to a local domain agent when this is absent.

# ── MySQL (system of record) ───────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ticketiq
MYSQL_USER=ticketiq_user
MYSQL_PASSWORD=ticketiq_pass

# ── MongoDB (AI analysis logs) ─────────────────────
MONGODB_URI=mongodb://localhost:27017/ticketiq

# ── Service ports ──────────────────────────────────
BACKEND_PORT=8080
BACKEND_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
FRONTEND_PORT=4200
